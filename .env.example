# FanPilot has no runtime secrets. Optional build/run variables (names only):

# scripts/build-app.sh
CONFIG=            # release (default) or debug
UNIVERSAL=         # 1 = build arm64 + x86_64
SIGN_IDENTITY=     # codesign identity name (default: a Developer ID / Apple Development identity from the keychain, else ad-hoc "-")

# scripts/release.sh
NOTARY_PROFILE=    # notarytool keychain profile (xcrun notarytool store-credentials); needs a Developer ID

# FanPilot.app
FANPILOT_SNAPSHOT= # directory: render every screen to PNGs and quit
