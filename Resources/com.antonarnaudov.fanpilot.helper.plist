<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FanPilot's fan-control helper, embedded in FanPilot.app at
  Contents/Library/LaunchDaemons/. The app registers it with SMAppService;
  macOS manages it (System Settings > General > Login Items & Extensions)
  and removes it with the app.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antonarnaudov.fanpilot.helper</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/fanpilotd</string>
    <key>MachServices</key>
    <dict>
        <key>com.antonarnaudov.fanpilot.helper</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ExitTimeOut</key>
    <integer>20</integer>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/FanPilot-helper.log</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.antonarnaudov.fanpilot</string>
    </array>
</dict>
</plist>
